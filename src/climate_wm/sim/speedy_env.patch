diff --git a/source/env_control.f90 b/source/env_control.f90
new file mode 100644
index 0000000..54155ec
--- /dev/null
+++ b/source/env_control.f90
@@ -0,0 +1,388 @@
+!> Environment control for the climate world-model experiments (stage 14).
+!  Restart files, interventions (solar factor, CO2 absorptivity, SST patches,
+!  convection relaxation time, surface drag) and extra surface output
+!  (accumulated precipitation, near-surface fields, SST, insolation).
+module env_control
+    use types, only: p, sp
+    use params, only: ix, il, kx, mx, nx, ntr, nsteps, delt
+    use netcdf
+
+    implicit none
+
+    private
+    public read_control, write_restart, read_restart, apply_sst_patch
+    public save_surface, accumulate_step, output_surface, write_static
+    public save_tendencies, output_tendencies
+    public restart_in, restart_out, static_out
+    public heat_scale, moist_scale, mom_scale
+
+    integer, parameter :: max_patch = 8
+
+    character(len=256) :: restart_in = ''   !! Restart file to start from ('' = rest state)
+    character(len=256) :: restart_out = ''  !! Restart file written at the end of the run
+    character(len=256) :: static_out = ''   !! Static fields file written at initialization
+    real(p) :: solar_factor = 1.0           !! Multiplies the solar constant
+    real(p) :: co2_factor = 1.0             !! Multiplies the CO2-band absorptivity
+    real(p) :: conv_factor = 1.0            !! Multiplies the convective relaxation time
+    real(p) :: drag_factor = 1.0            !! Multiplies the surface drag coefficients
+    real(p) :: heat_scale = 1.0             !! Stage 15.4 cut: multiplies the physics temperature tendency
+    real(p) :: moist_scale = 1.0            !! Stage 15.4 cut: multiplies the physics humidity tendency
+    real(p) :: mom_scale = 1.0              !! Stage 15.4 cut: multiplies the physics wind tendency
+    integer :: n_patch = 0                  !! Number of SST anomaly patches
+    real(p) :: patch_lon(max_patch) = 0.0   !! Patch centre longitude (degrees east)
+    real(p) :: patch_lat(max_patch) = 0.0   !! Patch centre latitude (degrees north)
+    real(p) :: patch_radius(max_patch) = 10.0 !! Patch e-folding radius (degrees of arc)
+    real(p) :: patch_amp(max_patch) = 0.0   !! Patch amplitude (K)
+
+    real(p) :: prec_acc(ix,il) = 0.0        !! Accumulated precipitation since the last output (mm)
+    real(p) :: t0_sav(ix,il) = 0.0, u0_sav(ix,il) = 0.0, v0_sav(ix,il) = 0.0, ts_sav(ix,il) = 0.0
+    real(p) :: patch_field(ix,il) = 0.0     !! Sum of the SST patches (K), before masks
+
+    ! Stage 15 (simulator as teacher): per-process physics tendencies, averaged over the output interval
+    logical :: tend_out = .false.           !! Write yyyymmddhhmm_tend.nc at every output time
+    integer, parameter :: n_tend = 10
+    real(p) :: tend_acc(ix,il,kx,n_tend) = 0.0  !! Sums of the per-process tendencies since the last output
+    integer :: n_tend_acc = 0                !! Number of physics calls in tend_acc
+    ! Stage 15 episode group B: spatially correlated perturbation of the restart state
+    integer :: perturb_seed = 0             !! 0 = no perturbation
+    real(p) :: perturb_t = 0.0              !! rms temperature perturbation (K)
+    real(p) :: perturb_vor = 0.0            !! rms vorticity perturbation (1/s)
+    real(p) :: perturb_ps = 0.0             !! rms log surface pressure perturbation
+    real(p) :: perturb_scale = 8.0          !! e-folding total wavenumber of the perturbation spectrum
+
+contains
+    !> Reads the &control namelist and applies the parameter interventions.
+    subroutine read_control
+        use shortwave_radiation, only: solc, ablco2
+        use convection, only: trcnv
+        use surface_fluxes, only: cdl, cds
+        namelist /control/ restart_in, restart_out, static_out, solar_factor, co2_factor, &
+            & conv_factor, drag_factor, n_patch, patch_lon, patch_lat, patch_radius, patch_amp, tend_out, &
+            & perturb_seed, perturb_t, perturb_vor, perturb_ps, perturb_scale, heat_scale, moist_scale, mom_scale
+        logical :: exists
+
+        inquire(file="namelist.nml", exist=exists)
+        if (exists) then
+            open(10, file="namelist.nml")
+            read(10, nml=control)
+            close(10)
+        end if
+
+        solc = solc*solar_factor
+        ablco2 = ablco2*co2_factor
+        trcnv = trcnv*conv_factor
+        cdl = cdl*drag_factor
+        cds = cds*drag_factor
+        write (*,'(A,4F8.3,I3)') 'control: solar co2 conv drag factors, patches = ', &
+            & solar_factor, co2_factor, conv_factor, drag_factor, n_patch
+        if (n_patch > max_patch) stop 'n_patch > max_patch'
+        if (len_trim(restart_in) > 0) write (*,'(A,A)') 'control: restart from ', trim(restart_in)
+        ! the patch field needs the model geometry, so it is built on first use
+    end subroutine
+
+    !> Builds the SST patch field (needs the model geometry).
+    subroutine build_patches
+        use geometry, only: radang
+        integer :: i, j, n
+        real(p) :: pi, lat, lon, cosd, d
+        logical, save :: built = .false.
+
+        if (built) return
+        built = .true.
+        pi = 4.0*atan(1.0)
+        patch_field = 0.0
+        do n = 1, n_patch
+            do j = 1, il
+                lat = radang(j)
+                do i = 1, ix
+                    lon = (i - 1)*2.0*pi/ix
+                    cosd = sin(lat)*sin(patch_lat(n)*pi/180.0) + cos(lat)*cos(patch_lat(n)*pi/180.0)&
+                        & *cos(lon - patch_lon(n)*pi/180.0)
+                    d = acos(max(-1.0_p, min(1.0_p, cosd)))*180.0/pi
+                    patch_field(i,j) = patch_field(i,j) + patch_amp(n)*exp(-(d/patch_radius(n))**2)
+                end do
+            end do
+        end do
+    end subroutine
+
+    !> Adds the SST patches to the SST seen by the atmosphere (open sea only).
+    subroutine apply_sst_patch
+        use sea_model, only: sst_am, sice_am, fmask_s
+        if (n_patch <= 0) return
+        call build_patches
+        where (fmask_s > 0.0) sst_am = sst_am + patch_field*(1.0 - sice_am)
+    end subroutine
+
+    !> Keeps the near-surface diagnostics of the last physics call.
+    subroutine save_surface(t0, u0, v0, ts)
+        real(p), intent(in) :: t0(ix,il), u0(ix,il), v0(ix,il), ts(ix,il)
+        t0_sav = t0
+        u0_sav = u0
+        v0_sav = v0
+        ts_sav = ts
+    end subroutine
+
+    !> Accumulates precipitation over one leapfrog step (g/m2/s * s = 1e-3 mm).
+    subroutine accumulate_step
+        use auxiliaries, only: precnv, precls
+        prec_acc = prec_acc + (precnv + precls)*delt*1.0e-3
+    end subroutine
+
+    !> Writes the surface fields of this output time to yyyymmddhhmm_sfc.nc.
+    subroutine output_surface(timestep)
+        use date, only: model_datetime
+        use geometry, only: radang
+        use sea_model, only: sst_am
+        use shortwave_radiation, only: fsol
+        use auxiliaries, only: olr, tsr
+        integer, intent(in) :: timestep
+        character(len=19) :: file_name = 'yyyymmddhhmm_sfc.nc'
+        integer :: ncid, londim, latdim, timedim, lonvar, latvar, timevar, k, n
+        integer :: varid(9)
+        character(len=8), parameter :: names(9) = (/ 'tp      ', 't2m     ', 'u10     ', &
+            & 'v10     ', 'skt     ', 'sst     ', 'tisr    ', 'olr     ', 'tsr     ' /)
+        real(sp) :: field(ix,il)
+
+        write (file_name(1:4),'(i4.4)') model_datetime%year
+        write (file_name(5:6),'(i2.2)') model_datetime%month
+        write (file_name(7:8),'(i2.2)') model_datetime%day
+        write (file_name(9:10),'(i2.2)') model_datetime%hour
+        write (file_name(11:12),'(i2.2)') model_datetime%minute
+
+        call check(nf90_create(file_name, nf90_clobber, ncid))
+        call check(nf90_def_dim(ncid, "time", nf90_unlimited, timedim))
+        call check(nf90_def_dim(ncid, "lon", ix, londim))
+        call check(nf90_def_dim(ncid, "lat", il, latdim))
+        call check(nf90_def_var(ncid, "time", nf90_real4, timedim, timevar))
+        call check(nf90_def_var(ncid, "lon", nf90_real4, londim, lonvar))
+        call check(nf90_def_var(ncid, "lat", nf90_real4, latdim, latvar))
+        do n = 1, 9
+            call check(nf90_def_var(ncid, trim(names(n)), nf90_real4, (/ londim, latdim, timedim /), &
+                & varid(n)))
+        end do
+        call check(nf90_put_att(ncid, varid(1), "units", "mm since previous output"))
+        call check(nf90_enddef(ncid))
+        call check(nf90_put_var(ncid, timevar, timestep*24.0/real(nsteps,sp), (/ 1 /)))
+        call check(nf90_put_var(ncid, lonvar, (/ (3.75*k, k = 0, ix-1) /), (/ 1 /)))
+        call check(nf90_put_var(ncid, latvar, (/ (radang(k)*90.0/asin(1.0), k = 1, il) /), (/ 1 /)))
+        do n = 1, 9
+            select case (n)
+            case (1); field = real(prec_acc, sp)
+            case (2); field = real(t0_sav, sp)
+            case (3); field = real(u0_sav, sp)
+            case (4); field = real(v0_sav, sp)
+            case (5); field = real(ts_sav, sp)
+            case (6); field = real(sst_am, sp)
+            case (7); field = real(fsol, sp)
+            case (8); field = real(olr, sp)
+            case (9); field = real(tsr, sp)
+            end select
+            call check(nf90_put_var(ncid, varid(n), field, (/ 1, 1, 1 /)))
+        end do
+        call check(nf90_close(ncid))
+        prec_acc = 0.0
+    end subroutine
+
+    !> Adds the per-process tendencies of one physics call (T: K/s, q: g/kg/s, u, v: m/s^2).
+    subroutine save_tendencies(tt_cnv, tt_lsc, tt_rsw, tt_rlw, tt_pbl, qt_cnv, qt_lsc, qt_pbl, ut_pbl, vt_pbl)
+        real(p), dimension(ix,il,kx), intent(in) :: tt_cnv, tt_lsc, tt_rsw, tt_rlw, tt_pbl, qt_cnv, &
+            & qt_lsc, qt_pbl, ut_pbl, vt_pbl
+        if (.not. tend_out) return
+        tend_acc(:,:,:,1) = tend_acc(:,:,:,1) + tt_cnv
+        tend_acc(:,:,:,2) = tend_acc(:,:,:,2) + tt_lsc
+        tend_acc(:,:,:,3) = tend_acc(:,:,:,3) + tt_rsw
+        tend_acc(:,:,:,4) = tend_acc(:,:,:,4) + tt_rlw
+        tend_acc(:,:,:,5) = tend_acc(:,:,:,5) + tt_pbl
+        tend_acc(:,:,:,6) = tend_acc(:,:,:,6) + qt_cnv
+        tend_acc(:,:,:,7) = tend_acc(:,:,:,7) + qt_lsc
+        tend_acc(:,:,:,8) = tend_acc(:,:,:,8) + qt_pbl
+        tend_acc(:,:,:,9) = tend_acc(:,:,:,9) + ut_pbl
+        tend_acc(:,:,:,10) = tend_acc(:,:,:,10) + vt_pbl
+        n_tend_acc = n_tend_acc + 1
+    end subroutine
+
+    !> Writes the mean per-process tendencies since the last output to yyyymmddhhmm_tend.nc
+    !  (sigma levels, top to bottom as in the model).
+    subroutine output_tendencies(timestep)
+        use date, only: model_datetime
+        use geometry, only: radang, fsg
+        integer, intent(in) :: timestep
+        character(len=20) :: file_name = 'yyyymmddhhmm_tend.nc'
+        integer :: ncid, londim, latdim, levdim, timedim, lonvar, latvar, levvar, timevar, k, n
+        integer :: varid(n_tend)
+        character(len=8), parameter :: names(n_tend) = (/ 'tt_cnv  ', 'tt_lsc  ', 'tt_rsw  ', &
+            & 'tt_rlw  ', 'tt_pbl  ', 'qt_cnv  ', 'qt_lsc  ', 'qt_pbl  ', 'ut_pbl  ', 'vt_pbl  ' /)
+        real(sp) :: field(ix,il,kx)
+
+        if (.not. tend_out) return
+        write (file_name(1:4),'(i4.4)') model_datetime%year
+        write (file_name(5:6),'(i2.2)') model_datetime%month
+        write (file_name(7:8),'(i2.2)') model_datetime%day
+        write (file_name(9:10),'(i2.2)') model_datetime%hour
+        write (file_name(11:12),'(i2.2)') model_datetime%minute
+
+        call check(nf90_create(file_name, nf90_clobber, ncid))
+        call check(nf90_def_dim(ncid, "time", nf90_unlimited, timedim))
+        call check(nf90_def_dim(ncid, "lon", ix, londim))
+        call check(nf90_def_dim(ncid, "lat", il, latdim))
+        call check(nf90_def_dim(ncid, "lev", kx, levdim))
+        call check(nf90_def_var(ncid, "time", nf90_real4, timedim, timevar))
+        call check(nf90_def_var(ncid, "lon", nf90_real4, londim, lonvar))
+        call check(nf90_def_var(ncid, "lat", nf90_real4, latdim, latvar))
+        call check(nf90_def_var(ncid, "lev", nf90_real4, levdim, levvar))
+        do n = 1, n_tend
+            call check(nf90_def_var(ncid, trim(names(n)), nf90_real4, (/ londim, latdim, levdim, timedim /), &
+                & varid(n)))
+        end do
+        call check(nf90_put_att(ncid, nf90_global, "units", "tt: K/s, qt: g/kg/s, ut/vt: m/s2; mean since previous output"))
+        call check(nf90_enddef(ncid))
+        call check(nf90_put_var(ncid, timevar, timestep*24.0/real(nsteps,sp), (/ 1 /)))
+        call check(nf90_put_var(ncid, lonvar, (/ (3.75*k, k = 0, ix-1) /), (/ 1 /)))
+        call check(nf90_put_var(ncid, latvar, (/ (radang(k)*90.0/asin(1.0), k = 1, il) /), (/ 1 /)))
+        call check(nf90_put_var(ncid, levvar, real(fsg, sp), (/ 1 /)))
+        do n = 1, n_tend
+            field = real(tend_acc(:,:,:,n)/max(n_tend_acc, 1), sp)
+            call check(nf90_put_var(ncid, varid(n), field, (/ 1, 1, 1, 1 /)))
+        end do
+        call check(nf90_close(ncid))
+        tend_acc = 0.0
+        n_tend_acc = 0
+    end subroutine
+
+    !> Writes orography (m), land fraction and sea fraction to static_out.
+    subroutine write_static
+        use boundaries, only: phis0
+        use land_model, only: fmask_l
+        use sea_model, only: fmask_s
+        use physical_constants, only: grav
+        use geometry, only: radang
+        integer :: ncid, londim, latdim, lonvar, latvar, v1, v2, v3, k
+        if (len_trim(static_out) == 0) return
+        call check(nf90_create(trim(static_out), nf90_clobber, ncid))
+        call check(nf90_def_dim(ncid, "lon", ix, londim))
+        call check(nf90_def_dim(ncid, "lat", il, latdim))
+        call check(nf90_def_var(ncid, "lon", nf90_real4, londim, lonvar))
+        call check(nf90_def_var(ncid, "lat", nf90_real4, latdim, latvar))
+        call check(nf90_def_var(ncid, "orography", nf90_real4, (/ londim, latdim /), v1))
+        call check(nf90_def_var(ncid, "land_fraction", nf90_real4, (/ londim, latdim /), v2))
+        call check(nf90_def_var(ncid, "sea_fraction", nf90_real4, (/ londim, latdim /), v3))
+        call check(nf90_enddef(ncid))
+        call check(nf90_put_var(ncid, lonvar, (/ (3.75*k, k = 0, ix-1) /)))
+        call check(nf90_put_var(ncid, latvar, (/ (radang(k)*90.0/asin(1.0), k = 1, il) /)))
+        call check(nf90_put_var(ncid, v1, real(phis0/grav, sp)))
+        call check(nf90_put_var(ncid, v2, real(fmask_l, sp)))
+        call check(nf90_put_var(ncid, v3, real(fmask_s, sp)))
+        call check(nf90_close(ncid))
+    end subroutine
+
+    !> Writes the full model state (both leapfrog levels, land and sea states).
+    subroutine write_restart
+        use date, only: model_datetime
+        use prognostics, only: vor, div, t, ps, tr, phi
+        use land_model, only: stl_lm, stl_am
+        use sea_model, only: sst_om, sst_am, sstan_am, sice_om, sice_am, tice_om, tice_am, &
+            & ssti_om, sstan3, fmask_s
+        real(p) :: sst_nopatch(ix,il)
+        if (len_trim(restart_out) == 0) return
+        sst_nopatch = sst_am
+        if (n_patch > 0) then
+            call build_patches
+            where (fmask_s > 0.0) sst_nopatch = sst_am - patch_field*(1.0 - sice_am)
+        end if
+        open(20, file=trim(restart_out), access='stream', form='unformatted', status='replace')
+        write (20) model_datetime%year, model_datetime%month, model_datetime%day, &
+            & model_datetime%hour, model_datetime%minute
+        write (20) vor, div, t, ps, tr, phi
+        write (20) stl_lm, stl_am
+        write (20) sst_om, sst_nopatch, sstan_am, sice_om, sice_am, tice_om, tice_am, ssti_om, sstan3
+        close(20)
+        write (*,'(A,A)') 'control: wrote restart ', trim(restart_out)
+    end subroutine
+
+    !> Reads the state written by write_restart (after the first step was initialised).
+    subroutine read_restart
+        use date, only: model_datetime
+        use prognostics, only: vor, div, t, ps, tr, phi
+        use land_model, only: stl_lm, stl_am
+        use sea_model, only: sst_om, sst_am, sstan_am, sice_om, sice_am, tice_om, tice_am, &
+            & ssti_om, sstan3
+        integer :: yy, mm, dd, hh, mi
+        if (len_trim(restart_in) == 0) return
+        open(21, file=trim(restart_in), access='stream', form='unformatted', status='old')
+        read (21) yy, mm, dd, hh, mi
+        if (yy /= model_datetime%year .or. mm /= model_datetime%month .or. &
+            & dd /= model_datetime%day .or. hh /= model_datetime%hour .or. &
+            & mi /= model_datetime%minute) stop 'restart date differs from start_datetime'
+        read (21) vor, div, t, ps, tr, phi
+        read (21) stl_lm, stl_am
+        read (21) sst_om, sst_am, sstan_am, sice_om, sice_am, tice_om, tice_am, ssti_om, sstan3
+        close(21)
+        call perturb_state
+        ! the restart holds the SST without the patches of this run
+        call apply_sst_patch
+    end subroutine
+
+    !> Adds a smooth random perturbation (red spectrum exp(-l(l+1)/(L(L+1))), L = perturb_scale,
+    !  no global mean, two vertical patterns blended along sigma) to t, vor and log ps,
+    !  both leapfrog time levels.
+    subroutine perturb_state
+        use prognostics, only: vor, t, ps
+        use spectral, only: grid_to_spec, spec_to_grid, el2
+        use physical_constants, only: rearth
+        real(p) :: w(mx,nx), a, b
+        complex(p) :: pat(mx,nx,2)
+        integer :: k, nseed, i
+        integer, allocatable :: seeds(:)
+        if (perturb_seed == 0) return
+        call random_seed(size=nseed)
+        allocate(seeds(nseed))
+        seeds = (/ (perturb_seed*7919 + 104729*i, i = 1, nseed) /)
+        call random_seed(put=seeds)
+        w = exp(-el2*rearth**2/(perturb_scale*(perturb_scale + 1.0)))
+        ! temperature
+        call patterns(pat)
+        do k = 1, kx
+            a = cos(0.5*3.14159265*real(k-1, p)/real(kx-1, p))
+            b = sin(0.5*3.14159265*real(k-1, p)/real(kx-1, p))
+            t(:,:,k,1) = t(:,:,k,1) + perturb_t*(a*pat(:,:,1) + b*pat(:,:,2))
+            t(:,:,k,2) = t(:,:,k,2) + perturb_t*(a*pat(:,:,1) + b*pat(:,:,2))
+        end do
+        ! vorticity
+        call patterns(pat)
+        do k = 1, kx
+            a = cos(0.5*3.14159265*real(k-1, p)/real(kx-1, p))
+            b = sin(0.5*3.14159265*real(k-1, p)/real(kx-1, p))
+            vor(:,:,k,1) = vor(:,:,k,1) + perturb_vor*(a*pat(:,:,1) + b*pat(:,:,2))
+            vor(:,:,k,2) = vor(:,:,k,2) + perturb_vor*(a*pat(:,:,1) + b*pat(:,:,2))
+        end do
+        ! log surface pressure
+        call patterns(pat)
+        ps(:,:,1) = ps(:,:,1) + perturb_ps*pat(:,:,1)
+        ps(:,:,2) = ps(:,:,2) + perturb_ps*pat(:,:,1)
+        write (*,'(A,I8,3ES10.2)') 'control: perturbed state, seed and rms t vor ps = ', perturb_seed, &
+            & perturb_t, perturb_vor, perturb_ps
+    contains
+        !> Two independent filtered random fields with unit grid rms and zero mean, in spectral space.
+        subroutine patterns(out)
+            complex(p), intent(out) :: out(mx,nx,2)
+            real(p) :: g(ix,il), rms
+            integer :: j
+            do j = 1, 2
+                call random_number(g)
+                out(:,:,j) = grid_to_spec(g - 0.5)*w
+                out(1,1,j) = (0.0, 0.0)
+                g = spec_to_grid(out(:,:,j), 1)
+                rms = sqrt(sum(g**2)/size(g))
+                out(:,:,j) = out(:,:,j)/max(rms, 1.0e-12)
+            end do
+        end subroutine
+    end subroutine
+
+    subroutine check(status)
+        integer, intent(in) :: status
+        if (status /= nf90_noerr) then
+            print *, trim(nf90_strerror(status))
+            stop 'netcdf error in env_control'
+        end if
+    end subroutine
+end module
